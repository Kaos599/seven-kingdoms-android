<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcut: long-press the app icon -> Licences. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="licences"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_licences"
        android:shortcutLongLabel="@string/shortcut_licences">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.sevenkfans.sevenkingdoms"
            android:targetClass="com.sevenkfans.sevenkingdoms.LicencesActivity" />
    </shortcut>
</shortcuts>
