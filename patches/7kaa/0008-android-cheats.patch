+//-------- Begin of function sk_cheats_get_game_state --------//
+//
+// Read-only snapshot for the Android cheats panel (port/android/sk_cheats.cpp).
+// can_cheat mirrors the conditions under which Sys::process_key accepts cheat keys.
+//
+void sk_cheats_get_game_state(SkCheatsGameState *st)
+{
+   st->in_game   = sys.sys_flag == SYS_RUN;
+   st->can_cheat = 0;
+   st->cheat_on  = 0;
+
+   if( st->in_game && nation_array.player_recno && !remote.is_enable() &&
+       !nation_array.is_deleted(nation_array.player_recno) &&
+       !option_menu.is_active() && !in_game_menu.is_active() )
+   {
+      st->can_cheat = 1;
+      st->cheat_on  = (~nation_array)->cheat_enabled_flag ||
+                      sys.debug_session || sys.testing_session || scenario_cheat_flag;
+   }
+
+   st->king_undie = config.king_undie_flag;
+   st->fast_build = config.fast_build;
+}
+//--------- End of function sk_cheats_get_game_state ---------//
+#endif
