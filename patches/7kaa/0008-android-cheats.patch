+//-------- Begin of function sk_cheats_get_game_state --------//
+//
+// Read-only snapshot for the Android cheats panel (port/android/sk_cheats.cpp).
+// can_cheat mirrors the conditions under which Sys::process_key accepts cheat keys.
+//
+void sk_cheats_get_game_state(SkCheatsGameState *st)
+{
+   st->in_game   = sys.sys_flag == SYS_RUN;
+   st->can_cheat = 0;
+   st->cheat_on  = 0;
+
+   if( st->in_game && nation_array.player_recno && !remote.is_enable() &&
+       !nation_array.is_deleted(nation_array.player_recno) &&
+       !option_menu.is_active() && !in_game_menu.is_active() )
+   {
+      st->can_cheat = 1;
+      st->cheat_on  = (~nation_array)->cheat_enabled_flag ||
+                      sys.debug_session || sys.testing_session || scenario_cheat_flag;
+   }
+
+   st->king_undie = config.king_undie_flag;
+   st->fast_build = config.fast_build;
+}
+//--------- End of function sk_cheats_get_game_state ---------//
+
+//-------- Begin of function sk_cheats_unit_cheat --------//
+//
+// Android cheats panel: COMBAT +20 / SKILL +20 / SPY SKILL +20 applied to EVERY selected unit of the
+// player's nation. Per-unit effect and limits are copied from Sys::detect_cheat_key ('[' ']' '\'' cases),
+// which only touches unit_array.selected_recno. Selection is found like UnitArray::return_camp does:
+// loop over unit_array, skip deleted, selected_flag set, alive, Unit::is_own() (true nation, spies included).
+// Re-checks the same gates as the key path (not multiplayer, human nation, cheat mode enabled).
+// which: 0 = combat level, 1 = skill level, 2 = spy skill. Returns the number of units changed.
+//
+int sk_cheats_unit_cheat(int which)
+{
+   SkCheatsGameState st;
+   sk_cheats_get_game_state(&st);
+   if( !st.can_cheat || !st.cheat_on )
+      return 0;
+
+   int changed = 0;
+
+   for( int i=unit_array.size() ; i>0 ; i-- )
+   {
+      if( unit_array.is_deleted(i) )
+         continue;
+
+      Unit* unitPtr = unit_array[i];
+
+      if( !unitPtr->selected_flag )
+         continue;
+      if( unitPtr->hit_points<=0 || unitPtr->cur_action==SPRITE_DIE || unitPtr->action_mode==ACTION_DIE )
+         continue;
+      if( !unitPtr->is_own() )
+         continue;
+
+      if( which == 0 )           // same as case '[' in Sys::detect_cheat_key
+      {
+         unitPtr->set_combat_level( MIN(100, unitPtr->skill.combat_level+20) );
+         changed++;
+      }
+      else if( which == 1 )      // same as case ']'
+      {
+         if( unitPtr->skill.skill_id )
+         {
+            unitPtr->skill.skill_level = MIN(100, unitPtr->skill.skill_level+20);
+            changed++;
+         }
+      }
+      else if( which == 2 )      // same as case '\''
+      {
+         if( unitPtr->spy_recno && !spy_array.is_deleted(unitPtr->spy_recno) )
+         {
+            Spy* spyPtr = spy_array[unitPtr->spy_recno];
+
+            spyPtr->spy_skill = MIN(100, spyPtr->spy_skill+20);
+            changed++;
+         }
+      }
+   }
+
+   return changed;
+}
+//--------- End of function sk_cheats_unit_cheat ---------//
+
+//-------- Begin of function sk_cheats_reputation --------//
+//
+// Android cheats panel: REPUTATION +10 (delta 10) / -10 (delta -10) for the player's nation.
+// Copied from the scenario cheat keys 'r' and 'e' in Sys::detect_scenario_cheat_key (OSYS.cpp:2270-2288):
+// the reputation field is changed directly (not through NationBase::change_reputation, which the keys
+// do not use), then clamped to -100..100. Gates as sk_cheats_unit_cheat. Returns 1 if applied, 0 if not.
+//
+int sk_cheats_reputation(int delta)
+{
+   SkCheatsGameState st;
+   sk_cheats_get_game_state(&st);
+   if( !st.can_cheat || !st.cheat_on )
+      return 0;
+
+   Nation* nationPtr = nation_array[nation_array.player_recno];
+
+   if( delta > 0 )            // same as case 'r'
+   {
+      nationPtr->reputation += 10;
+      if( nationPtr->reputation > 100 )
+         nationPtr->reputation = (float) 100;
+   }
+   else                       // same as case 'e'
+   {
+      nationPtr->reputation -= 10;
+      if( nationPtr->reputation < -100 )
+         nationPtr->reputation = (float) -100;
+   }
+
+   return 1;
+}
+//--------- End of function sk_cheats_reputation ---------//
+
+//-------- Begin of function sk_cheats_race_pop --------//
+//
+// Android cheats panel: RACE POP +10 (delta 10) / -10 (delta -10) for the race selected in the selected
+// town. Copied from the scenario cheat keys 'w' and 'q' in Sys::detect_scenario_cheat_key
+// (OSYS.cpp:2230-2268). The race is Town::get_selected_race() (OTOWNIF.cpp:2242), i.e. the race
+// browsed in the town's own race list, not the town's majority race. Same town check as the keys
+// (own town only). Returns SK_CHEAT_DONE, SK_CHEAT_NO_TOWN (no own town selected), SK_CHEAT_NO_RACE
+// (no race selected or that race has no people), or SK_CHEAT_NOOP (gates not met, nothing done).
+//
+int sk_cheats_race_pop(int delta)
+{
+   SkCheatsGameState st;
+   sk_cheats_get_game_state(&st);
+   if( !st.can_cheat || !st.cheat_on )
+      return SK_CHEAT_NOOP;
+
+   if( !town_array.selected_recno )
+      return SK_CHEAT_NO_TOWN;
+
+   Town* townPtr = town_array[town_array.selected_recno];
+   if( townPtr->nation_recno != nation_array.player_recno )
+      return SK_CHEAT_NO_TOWN;
+
+   int result = SK_CHEAT_NO_RACE;
+   int raceId = townPtr->get_selected_race();
+   int townRecno = townPtr->town_recno;   // kept: kill_town_people can delete the town (last people gone)
+
+   if( raceId && townPtr->race_pop_array[raceId-1] )
+   {
+      if( delta > 0 )         // same as case 'w'
+      {
+         townPtr->init_pop(raceId, 10, 100);
+      }
+      else                    // same as case 'q', but the loop test uses the saved recno so it never reads a deleted town
+      {
+         for( int j=10; j>0 && !town_array.is_deleted(townRecno); --j )
+            townPtr->kill_town_people(raceId);
+      }
+      result = SK_CHEAT_DONE;
+   }
+
+   // Deliberate deviation from the original 'q' key: that key calls auto_set_layout() unconditionally, which
+   // is a use-after-delete when the town was emptied and removed. Skip it for a deleted town (still DONE).
+   if( !town_array.is_deleted(townRecno) )
+      townPtr->auto_set_layout();
+   return result;
+}
+//--------- End of function sk_cheats_race_pop ---------//
+
+//-------- Begin of function sk_cheats_heal_all --------//
+//
+// Android cheats panel: HEAL ALL.
+// Units: every unit of the player's nation that is alive (same filter as sk_cheats_unit_cheat, but no
+// selection test). hit_points = max_hit_points, the same refill the game uses for the immortal king
+// (OUNIT.cpp:952-953).
+// Firms: every firm of the player's nation, not under construction. hit_points = max_hit_points, the
+// same as the FIRM FULL HP key (OSYS.cpp:1939-1945). Firms still under construction are skipped,
+// because the construction code completes a firm as soon as hit_points reaches max (OFIRM.cpp:1437),
+// which would finish the building instead of only refilling it (see docs/CHEATS.md).
+// Returns the number of units healed (firms are not counted). Gates as sk_cheats_unit_cheat.
+//
+int sk_cheats_heal_all(void)
+{
+   SkCheatsGameState st;
+   sk_cheats_get_game_state(&st);
+   if( !st.can_cheat || !st.cheat_on )
+      return 0;
+
+   int healed = 0;
+
+   for( int i=unit_array.size() ; i>0 ; i-- )
+   {
+      if( unit_array.is_deleted(i) )
+         continue;
+
+      Unit* unitPtr = unit_array[i];
+
+      if( unitPtr->hit_points<=0 || unitPtr->cur_action==SPRITE_DIE || unitPtr->action_mode==ACTION_DIE )
+         continue;
+      if( !unitPtr->is_own() )
+         continue;
+
+      unitPtr->hit_points = unitPtr->max_hit_points;
+      healed++;
+   }
+
+   for( int i=firm_array.size() ; i>0 ; i-- )
+   {
+      if( firm_array.is_deleted(i) )
+         continue;
+
+      Firm* firmPtr = firm_array[i];
+
+      if( firmPtr->nation_recno != nation_array.player_recno || firmPtr->under_construction )
+         continue;
+
+      firmPtr->hit_points = firmPtr->max_hit_points;
+   }
+
+   return healed;
+}
+//--------- End of function sk_cheats_heal_all ---------//
+#endif
