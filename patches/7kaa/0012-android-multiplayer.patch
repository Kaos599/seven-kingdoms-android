+#ifdef __ANDROID__
+//------ Begin of function NewsArray::sk_notice -----//
+//
+// Android port: show a one-off notice in the news ticker. Multiplayer only. SK_NOTICE_MATCH_START (called
+// when a match starts) also re-arms the once-per-match desync notice.
+//
+// <int> noticeId - SK_NOTICE_MATCH_START or SK_NOTICE_DESYNC
+//
+void NewsArray::sk_notice(int noticeId)
+{
+	static char desyncShown = 0;
+
+	if( !remote.is_enable() )
+		return;
 
+	if( noticeId == SK_NOTICE_MATCH_START )
+		desyncShown = 0;
+	else if( noticeId == SK_NOTICE_DESYNC )
+	{
+		if( desyncShown )
+			return;
+		desyncShown = 1;
+	}
 
+	News* newsPtr = add_news( NEWS_SK_NOTICE, NEWS_NORMAL, 0, 0, 1 );
+
+	if( newsPtr )
+		newsPtr->short_para1 = noticeId;
+}
+//------- End of function NewsArray::sk_notice -----//
+#endif
