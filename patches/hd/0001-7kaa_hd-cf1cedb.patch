+void IMGcall IMGbltAreaStretch(char* imageBuf, int pitch, int desX, int desY, char* bitmapBuf, int srcX1, int srcY1, int srcX2, int srcY2)
+{
+	int dest = (desY + srcY1) * pitch + (desX + srcX1);
