+#ifdef __ANDROID__
+// Pick the logical resolution from the phone's screen: height 610, width = the largest multiple
+// of 32 not above screen_w/screen_h*610 (so the map view is a whole number of 32 px tiles and
+// zoom_width + 224 == width). Falls back to HD's 800x600 for narrow screens (<= 4:3) or if the
+// display size cannot be read. Runs from main() before sys.init(), i.e. before SDL_Init, so the
+// video subsystem is initialised here (reference counted; the later SDL_Init(SDL_INIT_VIDEO) in
+// Vga::init just bumps the count).
+static void android_choose_resolution()
+{
+	int w = 800, h = 600;
+	SDL_DisplayMode dm;
+
+	if( SDL_InitSubSystem(SDL_INIT_VIDEO) == 0 )
+	{
+		if( SDL_GetDesktopDisplayMode(0, &dm) == 0 && dm.w > 0 && dm.h > 0 )
+		{
+			long sw = dm.w > dm.h ? dm.w : dm.h;		// landscape: long edge is the width
+			long sh = dm.w > dm.h ? dm.h : dm.w;
+			int ww = (int) ((sw * 610 / sh) / 32 * 32);	// floor(sw*610/sh) then floor to x32
+			if( ww >= 800 && sw * 3 > sh * 4 )			// wider than 4:3
+			{
+				w = ww;
+				h = 610;
+			}
+		}
+	}
 
+	config_adv.vga_resolution_width = w;
+	config_adv.vga_resolution_height = h;
+}
+#endif
 
 //--------- Begin of function Config::init_resolution -----------//
 void Config::init_resolution()
 {
+#ifdef __ANDROID__
+	android_choose_resolution();
+#endif
 	// get resolution from config file
 	win_width = config_adv.vga_resolution_width;
 	win_height = config_adv.vga_resolution_height;
